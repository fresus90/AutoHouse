{
  "name": "autohouse",
  "version": "1.0.0",
  "private": true,
  "description": "AutoHouse – Web-App fuer automatisierte Lebensmittelbestellungen bei dm und REWE Lieferservice",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch src/index.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "npm run build:api && npm run build:web",
    "build:api": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "build:web": "vite build --config web/vite.config.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "user:create": "tsx src/cli/create-user.ts",
    "shop:login": "tsx src/cli/shop-login.ts",
    "shop:session": "tsx src/cli/shop-session.ts",
    "plan:run": "tsx src/cli/run-plan.ts",
    "postinstall": "node scripts/check-browser.mjs"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "express": "^4.21.2",
    "playwright": "1.56.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.0.7"
  }
}
