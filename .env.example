# ---------------------------------------------------------------------------
# AutoHouse – Beispielkonfiguration. Kopieren nach .env und Werte anpassen.
# ---------------------------------------------------------------------------

# HTTP
PORT=4000
# Kommagetrennt; nur noetig, wenn das Frontend auf einem anderen Origin laeuft.
CORS_ORIGINS=http://localhost:5173

# Datenbank (SQLite-Datei)
DATABASE_FILE=./data/autohouse.db

# Verzeichnis fuer Screenshots / Traces / Playwright-Storage-States
ARTIFACT_DIR=./data/runs
STATE_DIR=./data/state

# 32-Byte-Schluessel als Hex (64 Zeichen) fuer die Verschluesselung von
# Shop-Zugangsdaten und Browser-Sessions:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# Zeitzone fuer die Berechnung der Bestelltermine
TIMEZONE=Europe/Berlin

# Wie lange eine Anmeldung in der Web-App gilt. Auf dem Telefon lohnt ein
# hoher Wert, damit die installierte App nicht staendig nachfragt.
SESSION_TTL_DAYS=14

# Scheduler
SCHEDULER_ENABLED=true
SCHEDULER_TICK_MS=30000
# Wie viele Bestellungen gleichzeitig ausgefuehrt werden duerfen
MAX_CONCURRENT_RUNS=1

# --- SICHERHEITSSCHALTER -------------------------------------------------
# Solange false, wird NIEMALS eine kostenpflichtige Bestellung abgeschickt.
# Jeder Lauf endet dann im Warenkorb (Dry-Run) und protokolliert das Ergebnis.
ALLOW_REAL_ORDERS=false

# Browser
HEADLESS=true
# Optional: expliziter Pfad zur Chromium-Binary (z. B. in Containern)
# PLAYWRIGHT_CHROMIUM_EXECUTABLE=/opt/pw-browsers/chromium-1194/chrome-linux/chrome
BROWSER_TIMEOUT_MS=45000
BROWSER_LOCALE=de-DE

# --- Nur fuer den Betrieb mit Docker Compose ------------------------------
# Token des Cloudflare-Tunnels (Zero-Trust-Dashboard -> Networks -> Tunnels).
# Siehe docs/hosting.md, Schritt 4.
TUNNEL_TOKEN=
